# Šablona konfiguračních proměnných prostředí pro web Dominik Anděl
# Doplňte reálné hodnoty.

# ID měření Google Analytics (G-XXXXXXXXXX)
GOOGLE_ANALYTICS_ID=G-PLACEHOLDER

# E-mail, na který mají chodit poptávky z kontaktního formuláře (výchozí je Dominikův e-mail)
CONTACT_FORM_RECIPIENT=dominik.andel.beroun@example.com

# Formspree nebo Netlify Forms Endpoint (pokud se přejde z lokálního JS odesílání na externí službu)
FORM_API_ENDPOINT=https://formspree.io/f/placeholder
